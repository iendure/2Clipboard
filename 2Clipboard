readonly APP_NAME="2Clipboard"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${APP_NAME}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/${APP_NAME}"
INSTALL_DIR="${HOME}/.local/bin"
[ -d "${HOME}/.bin" ] && INSTALL_DIR="${HOME}/.bin"
readonly HISTORY_FILE="${CACHE_DIR}/history.log"
readonly SLOTS_DIR="${CACHE_DIR}/slots"
readonly TEMPLATES_DIR="${CONFIG_DIR}/templates"

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
dbg()  { [ "${TWOCLIP_DEBUG:-0}" = "1" ] && printf '[debug] %s\n' "$*" >&2 || true; }
err()  { printf '%s: error: %s\n'   "$APP_NAME" "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$APP_NAME" "$*" >&2; }

# ------------------------------------------------------------------------------
# Self-install (desactivable con TWOCLIP_NO_INSTALL=1)
# ------------------------------------------------------------------------------
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
TARGET_PATH="${INSTALL_DIR}/${APP_NAME}"
if [ "${TWOCLIP_NO_INSTALL:-0}" != "1" ] \
   && [ -f "$SCRIPT_PATH" ] && [ "$SCRIPT_PATH" != "$TARGET_PATH" ]; then
    mkdir -p "$INSTALL_DIR"
    if cp "$SCRIPT_PATH" "$TARGET_PATH" 2>/dev/null; then
        chmod +x "$TARGET_PATH" 2>/dev/null || true
        dbg "self-installed to $TARGET_PATH"
    fi
    case ":$PATH:" in
        *":$INSTALL_DIR:"*) ;;
        *) export PATH="$INSTALL_DIR:$PATH" ;;
    esac
fi

mkdir -p "$CACHE_DIR" "$SLOTS_DIR" "$CONFIG_DIR" "$TEMPLATES_DIR" 2>/dev/null || true

